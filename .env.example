# Private environment variables
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_CACHE_TTL="3600"
REDIS_URL="redis://localhost:6379"

# Public feature flags (embedded at build time)
PUBLIC_FEATURE_SKILLS_SECTION="true"
PUBLIC_FEATURE_EXPERIENCE_SECTION="true"
PUBLIC_FEATURE_EDUCATION_SECTION="true"
PUBLIC_FEATURE_CONTACT_SECTION="true"

# Feature Flag Environment Variables
# Set to 'false' to disable sections, any other value enables them

PUBLIC_FEATURE_SKILLS_SECTION=false
PUBLIC_FEATURE_EXPERIENCE_SECTION=true
PUBLIC_FEATURE_EDUCATION_SECTION=false
PUBLIC_FEATURE_CONTACT_SECTION=false
LINKEDIN_ACCESS_TOKEN="access_token"
LINKEDIN_CACHE_TTL=3600